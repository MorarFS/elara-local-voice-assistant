#!/bin/zsh
set -u

root="${ELARA_HOME:-$HOME/Library/Application Support/Elara}"
controller="$root/assistant.py"
action="${1:-open}"

if [[ ! -f "$controller" ]]; then
  print -u2 "Elara is not installed at $root"
  print -u2 "Run ./install-mac.sh from the Elara repository."
  exit 1
fi

case "$action" in
  open) exec /usr/bin/python3 "$controller" open ;;
  start) exec /usr/bin/python3 "$controller" start ;;
  stop) exec /usr/bin/python3 "$controller" stop ;;
  status) exec /usr/bin/python3 "$controller" status ;;
  models) exec /usr/bin/python3 "$controller" models ;;
  model) exec /usr/bin/python3 "$controller" model "${2:-}" ;;
  restart)
    /usr/bin/python3 "$controller" stop || exit $?
    exec /usr/bin/python3 "$controller" open
    ;;
  help|-h|--help)
    printf '%s\n' \
      'Usage: elara [open|start|stop|status|restart|models|model NAME|help]' \
      '' \
      'With no argument, Elara starts and opens in a minimizable app window.'
    ;;
  *)
    print -u2 "Unknown command: $action"
    print -u2 'Run elara help for available commands.'
    exit 2
    ;;
esac
